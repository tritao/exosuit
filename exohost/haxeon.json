{
  "version": 1,
  "package": {
    "name": "exosuit-exohost"
  },
  "entry": "app.ExohostMain",
  "sourceRoots": [
    "src",
    "../src"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-platform": {
      "path": "../haxeon/packages/platform"
    },
    "haxeon-credentials": {
      "path": "../haxeon/packages/credentials"
    },
    "processkit": {
      "path": "../native-packages/processes"
    },
    "noisekit": {
      "path": "../native-packages/noise"
    }
  },
  "native": {
    "cmake": {
      "source": "native",
      "target": "exosuit_exohost_native",
      "inputs": [
        "native/CMakeLists.txt",
        "../haxeon/vendor/nativekit/CMakeLists.txt"
      ]
    }
  },
  "target": "host",
  "outputDir": "build"
}
