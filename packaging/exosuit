#!/usr/bin/env bash
set -euo pipefail
install_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export LD_LIBRARY_PATH="$install_dir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export EXOSUIT_AGENT_LAUNCHER="${EXOSUIT_AGENT_LAUNCHER:-$install_dir/tools/exosuit-agent.hl}"
export HAXEON_LSP="${HAXEON_LSP:-$install_dir/tools/haxeon-lsp}"
exec "$install_dir/tools/hl" "$install_dir/exosuit.hl" "$@"
