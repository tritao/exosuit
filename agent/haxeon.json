{
  "version": 1,
  "package": {
    "name": "exosuit-agent"
  },
  "entry": "app.AgentMain",
  "sourceRoots": [
    "src",
    "../src"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-platform": {
      "path": "../haxeon/packages/platform"
    },
    "haxeon-credentials": {
      "path": "../haxeon/packages/credentials"
    },
    "haxeon-gpu": {
      "path": "../haxeon/packages/gpu"
    },
    "sqlitekit": {
      "path": "../native-packages/sqlite"
    },
    "terminalsession": {
      "path": "../native-packages/terminal/session"
    }
  },
  "native": {
    "cmake": {
      "source": "native",
      "target": "exosuit_agent_native",
      "inputs": [
        "native/CMakeLists.txt",
        "../haxeon/vendor/nativekit/CMakeLists.txt"
      ]
    }
  },
  "target": "host",
  "outputDir": "build"
}
