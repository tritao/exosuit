{
  "version": 1,
  "package": {
    "name": "hostservices"
  },
  "sourceRoots": [
    "../../src/platform",
    "../../src/process"
  ],
  "scopeSourceRoots": false,
  "dependencies": {},
  "native": {
    "cmake": {
      "source": "../../native",
      "target": "pragtical_hx",
      "library": "pragtical_hx",
      "inputs": [
        "../../native/CMakeLists.txt",
        "../../native/ffi/pragtical_hx.c",
        "../../native/headless/platform.c",
        "../../include/pragtical_hx/native.h",
        "../../include/pragtical_hx/platform.h",
        "../../include/pragtical_hx/platform_abi.h"
      ]
    }
  },
  "ffi": {
    "interfaces": [
      "../../bindings/pragtical_hx.hxi"
    ],
    "projections": [
      "../../bindings/pragtical_hx.hxmap"
    ]
  },
  "target": "host"
}
